---
import { Font } from 'astro:assets';
import Seo from '@/components/Seo.astro';
import JsonLd from '@/components/JsonLd.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import { defaultLocale, type Locale } from '@/i18n/ui';
import '@/styles/tokens.css';
import '@/styles/base.css';
import '@/styles/site.css';
import '@/styles/motion.css';

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata | string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const { title, description, image, type, noindex } = Astro.props;
const locale = (Astro.currentLocale ?? defaultLocale) as Locale;

// Set PUBLIC_GOATCOUNTER_CODE in .env to enable (see .env.example).
const goatcounterCode = import.meta.env.PUBLIC_GOATCOUNTER_CODE;
---

<!doctype html>
<html lang={locale}>
  <head>
    <Seo title={title} description={description} image={image} type={type} noindex={noindex} />
    <Font cssVariable="--font-kumbh" preload />
    <JsonLd
      data={{
        '@type': 'Person',
        name: 'Leonard Lemke',
        url: 'https://www.leonard-lemke.com',
        sameAs: [
          'https://github.com/Lemkinator',
          'https://www.instagram.com/lemkinator5/',
          'https://www.youtube.com/@leonardlemke',
          'https://x.com/lemkinator',
          'https://www.linkedin.com/in/leonard-lemke-201029238/',
        ],
      }}
    />
    {goatcounterCode && (
      <script
        is:inline
        data-goatcounter={`https://${goatcounterCode}.goatcounter.com/count`}
        async
        src="//gc.zgo.at/count.js"
      />
    )}
  </head>
  <body>
    <div class="scroll-progress" aria-hidden="true"></div>
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
<script>
  import { initKonami } from '@/scripts/konami';
  import { initReveal } from '@/scripts/reveal';
  import { initMagnetic } from '@/scripts/magnetic';
  initKonami();
  // Runs once globally — every [data-reveal] element on the page (not just
  // card grids) gets picked up.
  initReveal();
  // .button-pill is safe to init here since it's always server-rendered by
  // this point; .gallery__dot is created client-side by gallery.ts, which
  // calls initMagnetic() itself once its dots exist.
  initMagnetic('.button-pill');

  console.log(
    '%c leonard-lemke.com ',
    'background:#7d97ff;color:#131313;font-weight:800;padding:2px 8px;border-radius:4px;',
  );
  console.log(
    '%cLike the animations? Source: https://github.com/Lemkinator/website\n' +
      "Psst — there's a Konami code on this page.",
    'color:#9a9ba8;font-size:12px;',
  );
</script>
