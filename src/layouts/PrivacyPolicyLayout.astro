---
import BaseLayout from './BaseLayout.astro';
import Banner from '@/components/Banner.astro';
import { useTranslations, defaultLocale, type Locale } from '@/i18n/ui';

interface Props {
  appName: string;
  lastUpdated: Date;
  icon: ImageMetadata;
  bannerImage: ImageMetadata;
  bannerImageAlt: string;
}

const { appName, lastUpdated, icon, bannerImage, bannerImageAlt } = Astro.props;
const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);

const dateFormatted = new Intl.DateTimeFormat(locale === 'de' ? 'de-DE' : 'en-US', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
}).format(lastUpdated);
---

<BaseLayout title={`${appName} — ${t('privacy.title')}`} description={`${appName} ${t('privacy.title')}`} image={icon}>
  <Banner image={bannerImage} title={appName} subtitle={t('privacy.title')} imageAlt={bannerImageAlt} compact />

  <div class="content">
    <slot />
    <p class="privacy-updated">{t('privacy.lastUpdated').replace('{date}', dateFormatted)}</p>
  </div>
</BaseLayout>
