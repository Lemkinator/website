---
// Collapses the 5 near-identical apps/*/privacy-policy.html pages (diffed:
// they differ only by app name, contact email, last-updated date, and meta
// tags — Sudoku is the one outlier with an extra Play Games data section)
// into a single template driven by content-collection frontmatter.
import BaseLayout from './BaseLayout.astro';
import { useTranslations, defaultLocale, type Locale } from '@/i18n/ui';

interface Props {
  appName: string;
  lastUpdated: Date;
  icon: string;
}

const { appName, lastUpdated, icon } = Astro.props;
const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);

const dateFormatted = new Intl.DateTimeFormat(locale === 'de' ? 'de-DE' : 'en-US', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
}).format(lastUpdated);
---

<BaseLayout
  title={`${appName} — ${t('privacy.title')}`}
  description={`${appName} ${t('privacy.title')}`}
  image={icon}
>
  <div class="content" data-reveal="up">
    <slot />
    <p class="privacy-updated">{t('privacy.lastUpdated').replace('{date}', dateFormatted)}</p>
  </div>
</BaseLayout>
