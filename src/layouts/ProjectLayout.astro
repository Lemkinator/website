---
import BaseLayout from './BaseLayout.astro';
import Giscus from '@/components/Giscus.astro';

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata | string;
  noindex?: boolean;
  comments?: boolean;
}

const { title, description, image, noindex, comments = true } = Astro.props;
---

<BaseLayout title={title} description={description} image={image} type="article" noindex={noindex}>
  <slot />
  {comments && <Giscus />}
</BaseLayout>
