---
// Replaces navbar.html + the client-side $.get("/navbar.html").replaceWith()
// injection. This renders server-side as part of the page, so there is no
// AJAX round-trip, no anti-FOUC display:none hack, and no delay before the
// nav/font/links exist in the DOM.
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations, defaultLocale, getLocaleAgnosticPath, type Locale } from '@/i18n/ui';
import LangToggle from './LangToggle.astro';

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);

const links = [
  { key: 'nav.home', path: '/' },
  { key: 'nav.about', path: '/about' },
  { key: 'nav.apps', path: '/apps' },
  { key: 'nav.media', path: '/media' },
] as const;

// Drives both aria-current and the sliding .navbar__indicator pill, which
// carries view-transition-name: nav-indicator (site.css) so it glides to
// its new position instead of popping across navigations.
const currentPath = getLocaleAgnosticPath(locale, Astro.url.pathname);
function isActive(path: string): boolean {
  return path === '/' ? currentPath === '/' : currentPath === path || currentPath.startsWith(`${path}/`);
}
---

<nav class="navbar">
  <div class="navbar__container">
    <a href={getRelativeLocaleUrl(locale, '/')} class="navbar__name">
      <img class="navbar__logo" src="/images/logo/icon_50.png" width="50" height="50" alt="logo" />
    </a>
    <input type="checkbox" id="mobile-menu-toggle" class="navbar__toggle-input" aria-label="Toggle menu" />
    <label for="mobile-menu-toggle" class="navbar__toggle" aria-hidden="true">
      <span class="bar"></span>
      <span class="bar"></span>
      <span class="bar"></span>
    </label>
    <ul class="navbar__menu">
      {
        links.map((link) => {
          const active = isActive(link.path);
          return (
            <li class="navbar__item">
              <a
                href={getRelativeLocaleUrl(locale, link.path)}
                class="navbar__links"
                aria-current={active ? 'page' : undefined}
              >
                {t(link.key)}
                {active && <span class="navbar__indicator" aria-hidden="true" />}
              </a>
            </li>
          );
        })
      }
      <li class="navbar__item navbar__item--lang">
        <LangToggle />
      </li>
    </ul>
  </div>
</nav>
