---
// Replaces <swiper-container>/<swiper-slide> (Swiper 9 loaded unpinned from
// jsdelivr on 10 legacy pages) with a dependency-free CSS scroll-snap
// carousel. No JS, no CDN request, works with keyboard/touch natively.
//
// Two sizing modes, since "one size fits all" kept breaking one context or
// another:
// - default: compact, height-driven (portrait phone screenshots, square
//   about-page photos) — each item sized by its own aspect ratio, capped
//   so it doesn't dominate.
// - full: landscape media (FPV clips/photos) — each item fills the content
//   column width, one at a time, scroll/snap to the next.
import { useTranslations, defaultLocale, type Locale } from '@/i18n/ui';
import Icon from './Icon.astro';

interface Props {
  class?: string;
  full?: boolean;
}

const { class: className, full = false } = Astro.props;
const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);
---

<div
  class:list={['gallery', className, { 'gallery--full': full }]}
  data-goto-label={t('gallery.goToSlide')}
>
  <div class="gallery__track">
    <slot />
  </div>
  <button type="button" class="gallery__arrow gallery__arrow--prev" aria-label={t('gallery.prev')}>
    <Icon name="chevron" />
  </button>
  <button type="button" class="gallery__arrow gallery__arrow--next" aria-label={t('gallery.next')}>
    <Icon name="chevron" />
  </button>
</div>
<script>
  import { initGallery } from '@/scripts/gallery';
  initGallery();
</script>

<style>
  .gallery {
    position: relative;
  }

  /* Prev/next affordance — primarily for mouse/keyboard users, since touch
     already has native swipe and desktop has drag (see gallery.ts). Sits
     over the track rather than taking layout space, centered vertically. */
  .gallery__arrow {
    appearance: none;
    position: absolute;
    top: 50%;
    translate: 0 -50%;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: none;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-bg) 70%, transparent);
    color: var(--color-fg);
    cursor: pointer;
    backdrop-filter: blur(4px);
    transition: background var(--dur-fast) var(--ease-spring), opacity var(--dur-fast) var(--ease-spring);
  }

  .gallery__arrow:hover {
    background: color-mix(in srgb, var(--color-bg) 90%, transparent);
  }

  .gallery__arrow:focus-visible {
    outline: 2px solid var(--color-fg);
    outline-offset: 2px;
  }

  .gallery__arrow:disabled {
    opacity: 0;
    pointer-events: none;
  }

  .gallery__arrow--prev {
    left: var(--space-2);
  }

  .gallery__arrow--next {
    right: var(--space-2);
  }

  .gallery__arrow--next :global(svg) {
    transform: rotate(180deg);
  }

  .gallery__track {
    display: flex;
    /* align-items defaults to stretch — combined with height:auto below,
       that was silently vertically stretching every image to match the
       row's cross-axis size (width stayed correct, height didn't), which
       is exactly what read as "distorted". flex-start opts every item out
       of stretch regardless of whether its height is auto or explicit. */
    align-items: flex-start;
    gap: var(--space-2);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    padding-bottom: var(--space-2);
    cursor: grab;
    /* Native scrollbar replaced by the snap+drag/wheel affordances below —
       a visible track competed with the images for attention and was the
       main complaint. Touch/trackpad swipe and keyboard scrolling still
       work identically; only the visible bar is gone. */
    scrollbar-width: none;
  }

  .gallery__track::-webkit-scrollbar {
    display: none;
  }

  /* While actively dragged with a mouse (src/scripts/gallery.ts), scrollLeft
     is set directly every pointermove — snap fighting that mid-drag reads as
     stutter, so it's suspended until release. Also blocks the image-drag
     ghost/text-selection a raw mouse drag would otherwise trigger. */
  .gallery__track.is-dragging {
    scroll-snap-type: none;
    scroll-behavior: auto;
    cursor: grabbing;
    user-select: none;
  }

  .gallery__track.is-dragging :global(img),
  .gallery__track.is-dragging :global(video) {
    pointer-events: none;
  }

  /* Some slides are a bare <img>/<video>; others (e.g. the drone-journey
     gallery on media/index.astro) wrap it in a <div><img><p class="description">
     for a caption. flex:0 0 auto shrink-wraps the slide to its content. */
  .gallery__track > :global(*) {
    flex: 0 0 auto;
    scroll-snap-align: center;
  }

  .gallery__track :global(img),
  .gallery__track :global(video) {
    border-radius: var(--radius-md);
    display: block;
    /* max-height, not height: an explicit height ignores the width cap
       when it kicks in, distorting non-square images. width/height:auto
       must be declared here too — Chrome only jointly preserves aspect
       ratio against both max-* caps when auto is set in the same rule,
       not just inherited as the (identical) computed value from another
       rule (site.css's img,video{height:auto} reset). */
    width: auto;
    height: auto;
    max-height: min(60vh, 480px);
    /* % of the track's own box, not the viewport: 90vw measures past
       .content's side padding, so on narrow screens a wide-capped image
       could exceed the track's actual available width and get clipped
       by its overflow-x instead of shrinking to fit. */
    max-width: 90%;
  }

  /* Full mode: item fills the content column width; height follows the
     image's own aspect ratio instead of being height-capped. */
  .gallery--full .gallery__track > :global(*) {
    width: 100%;
  }

  .gallery--full .gallery__track :global(img),
  .gallery--full .gallery__track :global(video) {
    width: 100%;
    max-width: 100%;
    height: auto;
    max-height: none;
  }
</style>
