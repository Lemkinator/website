---
// Splits `text` into per-character spans at build time, for the
// glyph-decode reveal in src/scripts/scramble.ts. The real string lives in
// aria-label on the wrapper; the per-character spans are aria-hidden, so
// screen readers read the word once and never see the scramble.
//
// Each animated char renders two overlaid spans: `.split-text__real` (the
// actual character — always present, never mutated by the animation) and
// `.split-text__fx` (decorative, holds the cycling random glyph). This
// keeps the true text in the DOM at all times, so anything reading
// textContent right after load (crawlers, screenshot/scrape tooling) sees
// the real heading instead of a mid-scramble glyph.
interface Props {
  text: string;
  class?: string;
}

const { text, class: className } = Astro.props;
const chars = [...text];
// Whitespace and invisible format characters (variation selectors,
// zero-width joiners, ...) aren't worth animating — skip them so they
// don't get a distracting glyph substitute of their own.
const isAnimatable = (char: string) => char.trim() !== '' && !/\p{Cf}/u.test(char);
---

<span class:list={['split-text', className]} aria-label={text} data-scramble>
  {
    chars.map((char) =>
      isAnimatable(char) ? (
        <span aria-hidden="true" class="split-text__char">
          <span class="split-text__real">{char}</span>
          <span class="split-text__fx" aria-hidden="true" />
        </span>
      ) : (
        <span aria-hidden="true">{char}</span>
      )
    )
  }
</span>
<style>
  .split-text__char {
    position: relative;
    display: inline-block;
  }

  .split-text__fx {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
  }

  .split-text__char.is-scrambling .split-text__real {
    opacity: 0;
  }

  .split-text__char.is-scrambling .split-text__fx {
    opacity: 1;
  }
</style>
<script>
  import { initScramble } from '@/scripts/scramble';
  initScramble();
</script>
