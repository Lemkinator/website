---
// Generic JSON-LD emitter. Callers pass a plain schema.org object; see
// BaseLayout.astro (Person schema) and src/pages/apps/[slug].astro
// (SoftwareApplication schema) for how it's used.
interface Props {
  data: Record<string, unknown>;
}

const { data } = Astro.props;
---

<script is:inline type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', ...data })} />
