---
import { getImage, Image } from 'astro:assets';
import Icon from './Icon.astro';

interface Props {
  href: string;
  bgImg: ImageMetadata | string;
  title: string;
  description: string;
  date?: string;
  interactionIcon?: 'download' | 'eye';
  interactionText?: string;
  tags?: string[];
  // App cards only. bgImg here is the same bannerImage the detail page's
  // Banner uses, so the card->banner view-transition morphs one continuous
  // photo instead of an icon expanding into an unrelated image. Sized to
  // roughly match #app-icon in site.css.
  icon?: ImageMetadata;
  // Shared-element name for the view-transition morph into the detail
  // page's Banner — must be unique per document.
  transitionName?: string;
  revealIndex?: number;
  // Base path (no extension) of a hover preview clip — see initVideoPeek()
  // in pointer.ts. Both `${previewVideo}.webm` and `${previewVideo}.mp4`
  // must exist.
  previewVideo?: string;
  bgPosition?: string;
}

const {
  href,
  bgImg,
  title,
  description,
  date,
  interactionIcon,
  interactionText,
  tags = [],
  icon,
  transitionName,
  revealIndex,
  previewVideo,
  bgPosition,
} = Astro.props;

const resolvedBg = typeof bgImg === 'string' ? bgImg : (await getImage({ src: bgImg, format: 'avif', width: 800 })).src;

// Splits e.g. "10000 +" into the countable digits (animated by counter.ts)
// and the static suffix; falls back to plain text if it doesn't start with a number.
const countMatch = interactionText?.match(/^(\d+)(.*)$/);
const countValue = countMatch?.[1];
const countSuffix = countMatch?.[2] ?? '';

const style = [
  `--bg-img: url(${resolvedBg})`,
  bgPosition && `--bg-pos: ${bgPosition}`,
  transitionName && `view-transition-name: ${transitionName}`,
  revealIndex !== undefined && `--i: ${revealIndex}`,
]
  .filter(Boolean)
  .join('; ');
---

<div class="card-grid-space">
  <a
    class="card"
    href={href}
    style={style}
    data-reveal={revealIndex !== undefined ? 'stagger' : undefined}
    data-tilt
    data-video-peek={previewVideo ? '' : undefined}
  >
    {
      previewVideo && (
        <div class="card__preview-wrap">
          <video class="card__preview" muted loop playsinline preload="none" aria-hidden="true">
            <source src={`${previewVideo}.webm`} type="video/webm" />
            <source src={`${previewVideo}.mp4`} type="video/mp4" />
          </video>
          <div class="card__preview-scrim" />
        </div>
      )
    }
    {/* Rendered at 80x80 CSS px (site.css .card__icon) — 160 covers 2x DPR. */}
    {icon && <Image class="card__icon" src={icon} alt="" width={160} height={160} />}
    {date && <div class="date">{date}</div>}
    {
      interactionIcon && interactionText && (
        <div class="interaction">
          <Icon name={interactionIcon} />
          &nbsp;&nbsp;
          {countValue ? (
            <>
              <span data-count-to={countValue}>{countValue}</span>
              {countSuffix}
            </>
          ) : (
            interactionText
          )}
        </div>
      )
    }
    <div class="card__content">
      <h1>{title}</h1>
      <p>{description}</p>
      {
        tags.length > 0 && (
          <div class="tags">
            {tags.map((tag) => (
              <div class="tag">{tag}</div>
            ))}
          </div>
        )
      }
    </div>
  </a>
</div>
