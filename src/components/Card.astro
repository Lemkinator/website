---
// One project card. Replaces the hand-copied
// <div class="card-grid-space"><a class="card" style="--bg-img: ..."> markup
// that used to be pasted per-project (with lang="en"/lang="de" pairs inside)
// on index.html, apps/index.html and media/index.html.
// Styling lives in src/styles/site.css (.cards-wrapper/.card/.tag/...).
import { getImage, Image } from 'astro:assets';
import Icon from './Icon.astro';

interface Props {
  href: string;
  // Either a plain public/ path (every content-collection-driven card —
  // apps and media listings) or a local src/assets import (currently just
  // the homepage's two hub tiles). See Banner.astro for the same pattern.
  bgImg: ImageMetadata | string;
  title: string;
  description: string;
  date?: string;
  interactionIcon?: 'download' | 'eye';
  interactionText?: string;
  tags?: string[];
  // App cards only — the squircle glyph, overlaid centered on top of bgImg
  // (which for apps is the same bannerImage the detail page's Banner uses,
  // so the card->banner view-transition morphs one continuous photo instead
  // of a small icon expanding into an unrelated image). Sized to roughly
  // match #app-icon on the detail page (site.css).
  icon?: ImageMetadata;
  // Shared-element name for the native view-transition morph into the
  // detail page's Banner (see src/styles/motion.css). Must be unique per
  // document — callers derive it from the project slug (e.g. `proj-${slug}`).
  transitionName?: string;
  // Stagger index for the scroll-reveal in motion.css ([data-reveal]'s --i).
  revealIndex?: number;
  // Base path (no extension) of a muted preview clip that plays on hover —
  // see initVideoPeek() in pointer.ts. Both `${previewVideo}.webm` and
  // `${previewVideo}.mp4` must exist. Optional: cards without footage
  // (e.g. the "2000" media project) just skip this entirely.
  previewVideo?: string;
}

const {
  href,
  bgImg,
  title,
  description,
  date,
  interactionIcon,
  interactionText,
  tags = [],
  icon,
  transitionName,
  revealIndex,
  previewVideo,
} = Astro.props;

const resolvedBg =
  typeof bgImg === 'string' ? bgImg : (await getImage({ src: bgImg, format: 'avif', width: 800 })).src;

// Splits "10000 +" into a countable number (animated by counter.ts) and a
// static suffix (" +"), so the count-up only ever touches the digits.
// Falls back to rendering interactionText verbatim if it doesn't start
// with a number.
const countMatch = interactionText?.match(/^(\d+)(.*)$/);
const countValue = countMatch?.[1];
const countSuffix = countMatch?.[2] ?? '';

const style = [
  `--bg-img: url(${resolvedBg})`,
  transitionName && `view-transition-name: ${transitionName}`,
  revealIndex !== undefined && `--i: ${revealIndex}`,
]
  .filter(Boolean)
  .join('; ');
---

<div class="card-grid-space">
  <a
    class="card"
    href={href}
    style={style}
    data-reveal={revealIndex !== undefined ? 'stagger' : undefined}
    data-tilt
    data-video-peek={previewVideo ? '' : undefined}
  >
    {
      previewVideo && (
        <div class="card__preview-wrap">
          <video class="card__preview" muted loop playsinline preload="none" aria-hidden="true">
            <source src={`${previewVideo}.webm`} type="video/webm" />
            <source src={`${previewVideo}.mp4`} type="video/mp4" />
          </video>
          <div class="card__preview-scrim"></div>
        </div>
      )
    }
    {/* Rendered at 80x80 CSS px (site.css .card__icon), matching #app-icon
       on the detail page — 160 covers 2x DPR. */}
    {icon && <Image class="card__icon" src={icon} alt="" width={160} height={160} />}
    {date && <div class="date">{date}</div>}
    {
      interactionIcon && interactionText && (
        <div class="interaction">
          <Icon name={interactionIcon} />
          &nbsp;&nbsp;
          {countValue ? (
            <>
              <span data-count-to={countValue}>{countValue}</span>
              {countSuffix}
            </>
          ) : (
            interactionText
          )}
        </div>
      )
    }
    <div class="card__content">
      <h1>{title}</h1>
      <p>{description}</p>
      {
        tags.length > 0 && (
          <div class="tags">
            {tags.map((tag) => (
              <div class="tag">{tag}</div>
            ))}
          </div>
        )
      }
    </div>
  </a>
</div>
