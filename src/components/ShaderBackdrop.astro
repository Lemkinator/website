---
// Self-guarding: if WebGL2 is unavailable or the visitor prefers reduced
// motion (see backdrop.ts), this renders nothing — Banner's photo behind
// it is still a complete page.
---

<canvas class="shader-backdrop" data-shader-canvas aria-hidden="true"></canvas>
<script>
  const canvas = document.querySelector('[data-shader-canvas]');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (canvas instanceof HTMLCanvasElement && !reduced) {
    const start = () => {
      import('@/scripts/backdrop').then((mod) => mod.initBackdrop(canvas));
    };
    if ('requestIdleCallback' in window) {
      window.requestIdleCallback(start, { timeout: 2000 });
    } else {
      setTimeout(start, 200);
    }
  }
</script>

<style>
  .shader-backdrop {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
</style>
