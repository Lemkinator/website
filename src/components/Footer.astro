---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { Image } from 'astro:assets';
import { useTranslations, footerLinks, defaultLocale, type Locale } from '@/i18n/ui';
import Icon from './Icon.astro';
import logoImg from '@/assets/images/logo/icon_50.png';

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);
const year = new Date().getFullYear();
---

<footer class="footer__container">
  <div data-reveal="up">
    <div class="footer__link-group">
      <div class="footer__link-column">
        <h2>{t('footer.contactMe')}</h2>
        <a href="mailto:contact@leonard-lemke.com">{t('footer.contact')}</a>
        <a href="mailto:support@leonard-lemke.com">{t('footer.support')}</a>
        <a target="_blank" rel="noopener noreferrer" href={footerLinks[locale].firstMeeting}>
          {t('footer.firstMeeting')}
        </a>
      </div>
      <div class="footer__link-column">
        <h2>{t('footer.links')}</h2>
        <a target="_blank" rel="noopener noreferrer" href="https://github.com/Lemkinator">Github</a>
        <a target="_blank" rel="noopener noreferrer" href="https://github.com/Lemkinator/website">
          {t('footer.sourceCode')}
        </a>
        <a href={getRelativeLocaleUrl(locale, '/imprint')}>{t('footer.imprint')}</a>
      </div>
    </div>
  </div>
  <section data-reveal="stagger" style="--i: 1">
    <div class="footer__social-inner">
      <a href={getRelativeLocaleUrl(locale, '/')}>
        <Image class="footer__logo" src={logoImg} width={50} height={50} alt="logo" />
      </a>
      <div class="footer__legal">
        <p class="footer__rights">&copy; Leonard Lemke {year}. {t('footer.rights')}</p>
        <p class="footer__ai-notice">{t('footer.aiContentNotice')}</p>
      </div>
      <div class="footer__social-icons">
        <a
          class="footer__social-icon"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Instagram"
          href="https://www.instagram.com/lemkinator5/"
        >
          <Icon name="instagram" />
        </a>
        <a
          class="footer__social-icon"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Youtube"
          href="https://www.youtube.com/@leonardlemke"
        >
          <Icon name="youtube" />
        </a>
        <a
          class="footer__social-icon"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="X"
          href="https://x.com/lemkinator"
        >
          <Icon name="x" />
        </a>
        <a
          class="footer__social-icon"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn"
          href="https://www.linkedin.com/in/leonard-lemke-201029238/"
        >
          <Icon name="linkedin" />
        </a>
        <a
          class="footer__social-icon"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Google Play"
          href="https://play.google.com/store/apps/dev?id=4961154860499174073"
        >
          <Icon name="play-store" />
        </a>
        {
          /* /rr is a gag redirect (astro.config.mjs redirects), no DE twin — both locales intentionally link to the same un-prefixed path. */
        }
        <a class="footer__social-icon" target="_blank" rel="noopener noreferrer" aria-label="Tik Tok" href="/rr">
          <Icon name="tiktok" />
        </a>
      </div>
    </div>
  </section>
</footer>
