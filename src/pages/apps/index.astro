---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Giscus from '@/components/Giscus.astro';
import CardGrid from '@/components/CardGrid.astro';
import Card from '@/components/Card.astro';
import Banner from '@/components/Banner.astro';
import { getAppCards } from '@/lib/projects';
import bannerImg from '@/assets/images/apps/banner.jpg';

const apps = await getAppCards('en');
---

<BaseLayout title="Apps" description="Leonard Lemke" image={bannerImg}>
  <Banner
    image={bannerImg}
    title="Apps"
    subtitle="Modern Apps in Samsungs OneUI-Design."
    imageAlt="AI-generated abstract artwork of OneUI app icon grids"
    transitionName="hub-apps"
  />

  <CardGrid>
    {
      apps.map((app, i) => (
        <Card
          href={app.href}
          bgImg={app.bgImg}
          title={app.title}
          description={app.description}
          date={app.dateLabel}
          interactionIcon={app.interactionIcon}
          interactionText={app.interactionText}
          tags={app.tags}
          iconStyle={app.iconStyle}
          transitionName={app.transitionName}
          revealIndex={i}
        />
      ))
    }
  </CardGrid>

  <Giscus />
</BaseLayout>
