---
import { getCollection } from 'astro:content';
import PrivacyPolicyLayout from '@/layouts/PrivacyPolicyLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('apps', (entry) => entry.id.startsWith('en/') && entry.data.privacyPolicy);
  return entries.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { name, icon, bannerImage, bannerImageAlt } = entry.data;
const { contactEmail, lastUpdated, includesPlayGamesSection } = entry.data.privacyPolicy!;
---

<PrivacyPolicyLayout
  appName={name}
  lastUpdated={lastUpdated}
  icon={icon}
  bannerImage={bannerImage}
  bannerImageAlt={bannerImageAlt}
>
  <h2>App</h2>
  <p>{name}</p>

  <h2>Provider/Operator</h2>
  <p>Leonard Lemke</p>
  <p>Email: <a href={`mailto:${contactEmail}`}>{contactEmail}</a></p>

  {
    includesPlayGamesSection ? (
      <>
        <h2>Privacy Information</h2>
        <p>
          The data mentioned below is collected by{' '}
          <a href="https://support.google.com/googleplay/topic/3114802?ref_topic=2952998">Google Play Games</a>,
          provided that the user logs in or has activated the automatic login. The Google Play Games services provide
          access for sign-in as well as services for game apps. Further settings, as well as the deletion of the data
          can be made in the Play Games profile.
        </p>
        <p>
          <a href="https://support.google.com/googleplay/answer/3129346?ref_topic=9167070">
            Play Games profile privacy &amp; other settings
          </a>
        </p>
        <p>
          <a href="https://support.google.com/googleplay/answer/9130646">Delete your Play Games profile and data</a>
        </p>

        <h3>Data encryption</h3>
        <p>
          For the collected end-user data listed on this page, Play Games Services encrypts the data in transit using
          HTTPS.
        </p>

        <h3>Data collected</h3>
        <p>
          Gamer Identity (Gamertag, avatar), analytics and diagnostics data and app activities (e.g. achievements,
          scores).
        </p>

        <h3>Data deletion</h3>
        <p>
          Users can delete their account and all associated games data collected by Google through their{' '}
          <a href="https://play.google.com/games/profile">Play Games profile</a> or{' '}
          <a href="https://myaccount.google.com/">Google MyAccount</a>.
        </p>
        <p>
          If Google collects Play Games Services data for an individual game, users can delete the data through their{' '}
          <a href="https://play.google.com/games/profile">Play Games profile</a>.
        </p>
      </>
    ) : (
      <>
        <h2>Privacy Information</h2>
        <p>The app does not collect or share user data.</p>
      </>
    )
  }

  <h2>Status of the data protection information</h2>
  <p>
    We review our privacy information on a regular basis. We reserve the right to change the privacy notice at any time
    with or without notice. Please check back periodically to be notified of any changes.
  </p>
</PrivacyPolicyLayout>
