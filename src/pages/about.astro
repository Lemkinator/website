---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Giscus from '@/components/Giscus.astro';
import Gallery from '@/components/Gallery.astro';
import Banner from '@/components/Banner.astro';
import bannerImg from '@/assets/images/about/banner.jpg';
import ogImg from '@/assets/images/about/me2.jpg';
import meImg from '@/assets/images/about/me.jpg';
import me3Img from '@/assets/images/about/me3.jpg';
import me4Img from '@/assets/images/about/me4.jpg';
import me5Img from '@/assets/images/about/me5.jpg';
---

<BaseLayout title="Leonard Lemke" description="About Me" image={ogImg}>
  <Banner
    image={bannerImg}
    title="About"
    subtitle={'"Those looking for quick success should not program, but chop wood."'}
    imageAlt="AI-generated abstract artwork of a misty forest with glowing code-like light trails"
  />

  <div class="content">
    <h2 id="me" class="heading-display text-gradient">Leonard Lemke</h2>
    <p class="quote">
      Hello, my name is Leonard. Besides my passion for technology, smartphones, Android and computer games, I like to
      program apps for Android in OneUI-Design or edit videos that I record with my racing drone.
    </p>
    <Gallery>
      <Image src={meImg} alt="" />
      <Image src={me3Img} alt="" />
      <Image src={me4Img} alt="" />
      <Image src={me5Img} alt="" />
    </Gallery>

    <div id="experience" class="section-gap">
      <h2 class="heading-display text-gradient">Experience</h2>

      <ol class="timeline">
        <li class="timeline__item" data-reveal="stagger">
          <div class="timeline__content">
            <h3 class="text-gradient">AUMOVIO</h3>

            <ol class="timeline__sub">
              <li class="timeline__sub-item" data-reveal="stagger">
                <p class="timeline__title">Software Developer / Software Architect</p>
                <span class="chip">September 2025 - Present</span>
              </li>
            </ol>
          </div>
        </li>

        <li class="timeline__item" data-reveal="stagger">
          <div class="timeline__content">
            <h3 class="text-gradient">Continental Automotive Technologies GmbH</h3>
            <span class="chip">September 2019 - August 2025</span>

            <ol class="timeline__sub">
              <li class="timeline__sub-item" data-reveal="stagger">
                <p class="timeline__title">Software Developer</p>
                <span class="chip">February 2024 - August 2025</span>
              </li>

              <li class="timeline__sub-item" data-reveal="stagger">
                <p class="timeline__title">Study Plus Mathem.-Tech. Softwaredeveloper</p>
                <span class="chip">September 2019 - February 2024</span>
              </li>

              <li class="timeline__sub-item" data-reveal="stagger">
                <p class="timeline__title">Bachelor Thesis</p>
                <p class="timeline__meta">
                  Parallel execution of cryptographic operations on ECUs in the automotive sector.
                </p>
                <span class="chip">September 2023 - December 2023</span>
                <div class="chip-row">
                  <span class="chip chip--primary">AUTOSAR</span>
                  <span class="chip chip--primary">AUTOSAR Crypto Stack</span>
                  <span class="chip chip--primary">Cryptography</span>
                  <span class="chip chip--primary">Cipher-Based Message Authentication Code</span>
                </div>
              </li>

              <li class="timeline__sub-item" data-reveal="stagger">
                <p class="timeline__title">Student Internship</p>
                <p class="timeline__meta">Port and adapt various tests from a platform to a customer project.</p>
                <span class="chip">October 2022 - March 2023</span>
                <div class="chip-row">
                  <span class="chip chip--primary">Elektrobit Tresos Studio</span>
                  <span class="chip chip--primary">AUTOSAR</span>
                  <span class="chip chip--primary">AUTOSAR Builder</span>
                  <span class="chip chip--primary">CAPL</span>
                  <span class="chip chip--primary">CAN</span>
                  <span class="chip chip--primary">CANoe</span>
                </div>
              </li>

              <li class="timeline__sub-item" data-reveal="stagger">
                <p class="timeline__title">Mathematical-Technical Software Engineer (MATSE)</p>
                <p class="timeline__meta">Apprenticeship as Mathematical-Technical Software Engineer (MATSE)</p>
                <p class="timeline__meta">(Included in Study Plus)</p>
                <span class="chip">September 2019 - August 2021</span>
              </li>
            </ol>
          </div>
        </li>

        <li class="timeline__item" data-reveal="stagger">
          <div class="timeline__content">
            <h3 class="text-gradient">Personal Projects</h3>

            <ol class="timeline__sub">
              <li class="timeline__sub-item" data-reveal="stagger">
                <p class="timeline__title">Software Developer Mobile Apps</p>
                <p class="timeline__meta">Developing modern Apps in Samsungs OneUI-Design.</p>
                <div class="chip-row">
                  <span class="chip">December 2019 - Present</span>
                  <span class="chip chip--secondary">Remote</span>
                </div>
                <div class="timeline__actions">
                  <button class="button-pill"><a href="/apps">Projects</a></button>
                  <button class="button-pill"><a href="mailto:apps@leonard-lemke.com">Contact</a></button>
                </div>
              </li>

              <li class="timeline__sub-item" data-reveal="stagger">
                <p class="timeline__title">Digital Creator</p>
                <p class="timeline__meta">Edit video recordings of a racing drone.</p>
                <p class="timeline__meta">Sharing experiences through the eyes of a Drone.</p>
                <div class="chip-row">
                  <span class="chip">May 2019 - Present</span>
                  <span class="chip chip--secondary">Remote</span>
                </div>
                <div class="timeline__actions">
                  <button class="button-pill"><a href="/media">Projects</a></button>
                  <button class="button-pill"><a href="mailto:media@leonard-lemke.com">Contact</a></button>
                </div>
              </li>
            </ol>
          </div>
        </li>
      </ol>
    </div>

    <div id="education" class="section-gap">
      <h2 class="heading-display text-gradient">Education</h2>

      <ol class="timeline">
        <li class="timeline__item" data-reveal="stagger">
          <div class="timeline__content">
            <h3 class="text-gradient">Bachelor of Science (B.Sc.)</h3>
            <p class="timeline__meta">Hochschule Furtwangen University (HFU) / Continental</p>
            <p class="timeline__meta">General Computer Science (Specialization Software Engineering)</p>
            <p class="timeline__meta">Study Plus</p>
            <div class="chip-row">
              <span class="chip">September 2019 - February 2024</span>
              <span class="chip chip--secondary">Grade: 1.4</span>
            </div>
          </div>
        </li>

        <li class="timeline__item" data-reveal="stagger">
          <div class="timeline__content">
            <h3 class="text-gradient">Apprenticeship</h3>
            <p class="timeline__meta">
              Kaufmännische und Hauswirtschaftliche Schulen Donaueschingen (KHS) / Continental
            </p>
            <p class="timeline__meta">Mathematical-technical Software Engineer (MATSE)</p>
            <p class="timeline__meta">(Included in Study Plus)</p>
            <div class="chip-row">
              <span class="chip">September 2019 - July 2021</span>
              <span class="chip chip--secondary">Grade: 90/100 P.</span>
            </div>
          </div>
        </li>

        <li class="timeline__item" data-reveal="stagger">
          <div class="timeline__content">
            <h3 class="text-gradient">High School Diploma</h3>
            <p class="timeline__meta">Gymnasium Trossingen</p>
            <div class="chip-row">
              <span class="chip">September 2011 - July 2019</span>
              <span class="chip chip--secondary">Grade: 1.7</span>
            </div>
          </div>
        </li>
      </ol>
    </div>
  </div>

  <Giscus />
</BaseLayout>
