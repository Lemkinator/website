---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Giscus from '@/components/Giscus.astro';
import Gallery from '@/components/Gallery.astro';
import Banner from '@/components/Banner.astro';
import bannerImg from '@/assets/images/about/banner.jpg';
import ogImg from '@/assets/images/about/me2.jpg';
import meImg from '@/assets/images/about/me.jpg';
import me3Img from '@/assets/images/about/me3.jpg';
import me4Img from '@/assets/images/about/me4.jpg';
import me5Img from '@/assets/images/about/me5.jpg';
---

<BaseLayout title="Leonard Lemke" description="About Me" image={ogImg}>
  <Banner
    image={bannerImg}
    title="About"
    subtitle={'"Those looking for quick success should not program, but chop wood."'}
    imageAlt="AI-generated abstract artwork of a misty forest with glowing code-like light trails"
  />

  <div class="content">
    <h2 id="me" class="heading-display text-gradient">Leonard Lemke</h2>
    <p class="quote">
      Hello, my name is Leonard. Besides my passion for technology, smartphones, Android and computer games, I like to
      program apps for Android in OneUI-Design or edit videos that I record with my racing drone.
    </p>
    <Gallery>
      <Image src={meImg} alt="" />
      <Image src={me3Img} alt="" />
      <Image src={me4Img} alt="" />
      <Image src={me5Img} alt="" />
    </Gallery>

    <div id="experience" class="section-gap">
      <h2 class="heading-display text-gradient">Experience</h2>

      <ol class="timeline">
        <li class="timeline__item" data-reveal="stagger" style="--i: 0">
          <div class="timeline__marker" aria-hidden="true"></div>
          <div class="timeline__content">
            <h3 class="text-gradient">AUMOVIO</h3>
            <p class="timeline__role">Software Developer / Software Architect</p>
            <p class="timeline__date">September 2025 - Present</p>
          </div>
        </li>

        <li class="timeline__item" data-reveal="stagger" style="--i: 1">
          <div class="timeline__marker" aria-hidden="true"></div>
          <div class="timeline__content">
            <h3 class="text-gradient">Continental Automotive Technologies GmbH</h3>
            <p class="timeline__date">September 2019 - August 2025</p>

            <ol class="timeline__sub">
              <li class="timeline__sub-item" data-reveal="stagger" style="--i: 0">
                <p class="timeline__role">Software Developer</p>
                <p class="timeline__date">February 2024 - August 2025</p>
              </li>

              <li class="timeline__sub-item" data-reveal="stagger" style="--i: 1">
                <p class="timeline__role">Study Plus Mathem.-Tech. Softwaredeveloper</p>
                <p class="timeline__date">September 2019 - February 2024</p>
              </li>

              <li class="timeline__sub-item" data-reveal="stagger" style="--i: 2">
                <p class="timeline__role">Bachelor Thesis</p>
                <p class="timeline__date">September 2023 - December 2023</p>
                <p class="timeline__description">
                  Parallel execution of cryptographic operations on ECUs in the automotive sector.
                </p>
                <div class="timeline__skills">
                  <span class="skill-tag">AUTOSAR</span>
                  <span class="skill-tag">AUTOSAR Crypto Stack</span>
                  <span class="skill-tag">Cryptography</span>
                  <span class="skill-tag">Cipher-Based Message Authentication Code</span>
                </div>
              </li>

              <li class="timeline__sub-item" data-reveal="stagger" style="--i: 3">
                <p class="timeline__role">Student Internship</p>
                <p class="timeline__date">October 2022 - March 2023</p>
                <p class="timeline__description">Port and adapt various tests from a platform to a customer project.</p>
                <div class="timeline__skills">
                  <span class="skill-tag">Elektrobit Tresos Studio</span>
                  <span class="skill-tag">AUTOSAR</span>
                  <span class="skill-tag">AUTOSAR Builder</span>
                  <span class="skill-tag">CAPL</span>
                  <span class="skill-tag">CAN</span>
                  <span class="skill-tag">CANoe</span>
                </div>
              </li>

              <li class="timeline__sub-item" data-reveal="stagger" style="--i: 4">
                <p class="timeline__role">Mathematical-Technical Software Engineer (MATSE)</p>
                <p class="timeline__date">September 2019 - August 2021</p>
                <p class="timeline__description">Apprenticeship as Mathematical-Technical Software Engineer (MATSE)</p>
                <p class="timeline__description">(Included in Study Plus)</p>
              </li>
            </ol>
          </div>
        </li>

        <li class="timeline__item" data-reveal="stagger" style="--i: 2">
          <div class="timeline__marker" aria-hidden="true"></div>
          <div class="timeline__content">
            <h3 class="text-gradient">Software Developer Mobile Apps</h3>
            <p class="timeline__date">December 2019 - Present</p>
            <p class="timeline__location">Remote - Leonard Lemke</p>
            <p class="timeline__description">Developing modern Apps in Samsungs OneUI-Design.</p>
            <div class="timeline__actions">
              <button class="button-pill"><a href="/apps">Projects</a></button>
              <button class="button-pill"><a href="mailto:apps@leonard-lemke.com">Contact</a></button>
            </div>
          </div>
        </li>

        <li class="timeline__item" data-reveal="stagger" style="--i: 3">
          <div class="timeline__marker" aria-hidden="true"></div>
          <div class="timeline__content">
            <h3 class="text-gradient">Digital Creator</h3>
            <p class="timeline__date">May 2019 - Present</p>
            <p class="timeline__location">Remote - Leonard Lemke</p>
            <p class="timeline__description">Edit video recordings of a racing drone.</p>
            <p class="timeline__description">Sharing experiences through the eyes of a Drone.</p>
            <div class="timeline__actions">
              <button class="button-pill"><a href="/media">Projects</a></button>
              <button class="button-pill"><a href="mailto:media@leonard-lemke.com">Contact</a></button>
            </div>
          </div>
        </li>
      </ol>
    </div>

    <div id="education" class="section-gap">
      <h2 class="heading-display text-gradient">Education</h2>

      <ol class="timeline">
        <li class="timeline__item" data-reveal="stagger" style="--i: 0">
          <div class="timeline__marker" aria-hidden="true"></div>
          <div class="timeline__content">
            <h3>Bachelor of Science (B.Sc.)</h3>
            <p class="timeline__date">September 2019 - February 2024</p>
            <span class="timeline__grade">Grade: 1.4</span>
            <p class="timeline__location">Hochschule Furtwangen University (HFU) / Continental</p>
            <p class="timeline__description">General Computer Science (Specialization Software Engineering)</p>
            <p class="timeline__description">Study Plus</p>
          </div>
        </li>

        <li class="timeline__item" data-reveal="stagger" style="--i: 1">
          <div class="timeline__marker" aria-hidden="true"></div>
          <div class="timeline__content">
            <h3>Apprenticeship</h3>
            <p class="timeline__date">September 2019 - July 2021</p>
            <span class="timeline__grade">Grade: 90/100 P.</span>
            <p class="timeline__location">
              Kaufmännische und Hauswirtschaftliche Schulen Donaueschingen (KHS) / Continental
            </p>
            <p class="timeline__description">Mathematical-technical Software Engineer (MATSE)</p>
            <p class="timeline__description">(Included in Study Plus)</p>
          </div>
        </li>

        <li class="timeline__item" data-reveal="stagger" style="--i: 2">
          <div class="timeline__marker" aria-hidden="true"></div>
          <div class="timeline__content">
            <h3>High School Diploma</h3>
            <p class="timeline__date">September 2011 - July 2019</p>
            <span class="timeline__grade">Grade: 1.7</span>
            <p class="timeline__location">Gymnasium Trossingen</p>
          </div>
        </li>
      </ol>
    </div>
  </div>

  <Giscus />
</BaseLayout>
