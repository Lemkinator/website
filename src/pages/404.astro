---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Banner from '@/components/Banner.astro';
---

<BaseLayout title="Leonard Lemke" description="404" image="/images/error-poster.jpg" noindex>
  <Banner
    image="/images/404/banner.jpg"
    title="404"
    subtitle="Looks like you're lost, the page you are looking for is not available!"
    imageAlt="AI-generated abstract artwork of a signpost dissolving into scattered light particles"
    compact
  />
  <div class="error">
    <img src="/images/error.webp" alt="" width="480" height="360" />
    <button class="lButton"><a href="/">Home</a></button>
  </div>
</BaseLayout>
