---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Giscus from '@/components/Giscus.astro';
import CardGrid from '@/components/CardGrid.astro';
import Card from '@/components/Card.astro';
import Banner from '@/components/Banner.astro';
import ShaderBackdrop from '@/components/ShaderBackdrop.astro';
import { useTranslations, defaultLocale, type Locale } from '@/i18n/ui';
import { getAllProjects } from '@/lib/projects';
import heroImage from '@/assets/images/about/me2.jpg';
import appsHubImage from '@/assets/images/apps/oneUI/OneUIBanner.jpg';
import mediaHubImage from '@/assets/images/media/evoque_v2.jpg';

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);

const allProjects = await getAllProjects(locale);
---

<BaseLayout title="Leonard Lemke" description="Website">
  <Banner
    image={heroImage}
    title="Leonard Lemke"
    subtitle="Software Developer passionate about apps in OneUI-Design & FPV drones"
    scrambleTitle
  >
    <ShaderBackdrop slot="backdrop" />
  </Banner>

  <div class="center" data-reveal="up">
    <h1 class="colored-h1">Projects</h1>
  </div>

  <CardGrid>
    <Card
      href="/apps"
      bgImg={appsHubImage}
      title="Apps"
      description="Modern Apps in Samsungs OneUI-Design."
      transitionName="hub-apps"
      revealIndex={0}
    />
    <Card
      href="/media"
      bgImg={mediaHubImage}
      title="Media"
      description={t('home.mediaTagline')}
      transitionName="hub-media"
      revealIndex={1}
    />
  </CardGrid>

  <br id="allprojects" /><br /><br /><br /><br /><br />
  <div class="center" data-reveal="up">
    <h1 class="colored-h1">All Projects</h1>
  </div>

  <CardGrid>
    {
      allProjects.map((project, i) => (
        <Card
          href={project.href}
          bgImg={project.bgImg}
          title={project.title}
          description={project.description}
          date={project.dateLabel}
          interactionIcon={project.interactionIcon}
          interactionText={project.interactionText}
          tags={project.tags}
          iconStyle={project.iconStyle}
          revealIndex={i}
        />
      ))
    }
  </CardGrid>

  <Giscus />
</BaseLayout>
