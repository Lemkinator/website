---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Giscus from '@/components/Giscus.astro';
import CardGrid from '@/components/CardGrid.astro';
import Card from '@/components/Card.astro';
import Banner from '@/components/Banner.astro';
import { useTranslations, defaultLocale, type Locale } from '@/i18n/ui';
import { getAllProjects } from '@/lib/projects';

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);

const allProjects = await getAllProjects(locale);
---

<BaseLayout title="Leonard Lemke" description="Website">
  <Banner image="/images/about/me2.jpg" title="Leonard Lemke" subtitle="Software Developer passionate about apps in OneUI-Design & FPV drones" />

  <div class="center">
    <h1 class="colored-h1">Projects</h1>
  </div>

  <CardGrid>
    <Card
      href="/apps"
      bgImg="https://www.leonard-lemke.com/images/apps/oneUI/OneUIBanner.jpg"
      title="Apps"
      description="Modern Apps in Samsungs OneUI-Design."
    />
    <Card
      href="/media"
      bgImg="https://www.leonard-lemke.com/images/media/evoque_v2.jpg"
      title="Media"
      description={t('home.mediaTagline')}
    />
  </CardGrid>

  <br id="allprojects" /><br /><br /><br /><br /><br />
  <div class="center">
    <h1 class="colored-h1">All Projects</h1>
  </div>

  <CardGrid>
    {
      allProjects.map((project) => (
        <Card
          href={project.href}
          bgImg={project.bgImg}
          title={project.title}
          description={project.description}
          date={project.dateLabel}
          interactionIcon={project.interactionIcon}
          interactionText={project.interactionText}
          tags={project.tags}
          iconStyle={project.iconStyle}
        />
      ))
    }
  </CardGrid>

  <Giscus />
</BaseLayout>
