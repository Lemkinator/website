---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Giscus from '@/components/Giscus.astro';
import CardGrid from '@/components/CardGrid.astro';
import Card from '@/components/Card.astro';
import Banner from '@/components/Banner.astro';
import ShaderBackdrop from '@/components/ShaderBackdrop.astro';
import { useTranslations, defaultLocale, type Locale } from '@/i18n/ui';
import { getAllProjects } from '@/lib/projects';
import heroImage from '@/assets/home/hero.jpg';
import appsHubImage from '@/assets/apps/banner.jpg';
import mediaHubImage from '@/assets/media/banner.jpg';

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);

const projects = await getAllProjects(locale);
---

<BaseLayout title="Leonard Lemke" description="Website">
  <Banner
    image={heroImage}
    title="Leonard Lemke"
    subtitle="Software Developer passionate about apps in OneUI-Design & FPV drones"
    imageAlt="AI-generated abstract artwork blending OneUI app icons with FPV drone light trails"
    focalPosition="center 40%"
    shineTitle
  >
    <ShaderBackdrop slot="backdrop" />
  </Banner>

  <CardGrid>
    <Card
      href="/apps"
      bgImg={appsHubImage}
      title="Apps"
      description="Modern Apps in Samsungs OneUI-Design."
      transitionName="hub-apps"
      revealIndex={0}
    />
    <Card
      href="/media"
      bgImg={mediaHubImage}
      title="Media"
      description={t('home.mediaTagline')}
      transitionName="hub-media"
      revealIndex={1}
    />
  </CardGrid>

  <div class="center section-gap" id="projects" data-reveal="up">
    <h1 class="heading-display text-gradient">Projects</h1>
  </div>

  <CardGrid>
    {
      projects.map((project, i) => (
        <Card
          href={project.href}
          bgImg={project.bgImg}
          bgPosition={project.bgPosition}
          title={project.title}
          description={project.description}
          date={project.dateLabel}
          interactionIcon={project.interactionIcon}
          interactionText={project.interactionText}
          tags={project.tags}
          icon={project.icon}
          revealIndex={i}
          previewVideo={project.previewVideo}
        />
      ))
    }
  </CardGrid>

  <Giscus />
</BaseLayout>
