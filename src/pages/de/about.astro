---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Giscus from '@/components/Giscus.astro';
import Gallery from '@/components/Gallery.astro';
import Banner from '@/components/Banner.astro';
import bannerImg from '@/assets/about/banner.jpg';
import ogImg from '@/assets/about/me2.jpg';
import meImg from '@/assets/about/me.jpg';
import me3Img from '@/assets/about/me3.jpg';
import me4Img from '@/assets/about/me4.jpg';
import me5Img from '@/assets/about/me5.jpg';
---

<BaseLayout title="Leonard Lemke" description="Über mich" image={ogImg}>
  <Banner
    image={bannerImg}
    title="About"
    subtitle={'"Wer den schnellen Erfolg sucht, sollte nicht programmieren, sondern Holz hacken."'}
    imageAlt="KI-generierte abstrakte Grafik eines nebligen Waldes mit leuchtenden, codeartigen Lichtspuren"
  />

  <div class="content">
    <h2 id="me" class="heading-display text-gradient">Leonard Lemke</h2>
    <p class="quote">
      Hallo, mein Name ist Leonard. Neben meiner Leidenschaft für Technik, Smartphones, Android und Computerspiele,
      programmiere ich gerne Apps für Android im OneUI-Design oder bearbeite Videos, die ich mit meiner Racing-Drohne
      aufnehme.
    </p>
    <Gallery>
      <Image src={meImg} alt="" />
      <Image src={me3Img} alt="" />
      <Image src={me4Img} alt="" />
      <Image src={me5Img} alt="" />
    </Gallery>

    <div id="experience" class="section-gap">
      <h2 class="heading-display text-gradient">Erfahrung</h2>

      <ol class="timeline">
        <li class="timeline__item" data-reveal="stagger">
          <div class="timeline__content">
            <h3 class="text-gradient">AUMOVIO</h3>

            <ol class="timeline__sub">
              <li class="timeline__sub-item" data-reveal="stagger">
                <p class="timeline__title">Softwareentwickler / Softwarearchitekt</p>
                <span class="chip">September 2025 - Heute</span>
              </li>
            </ol>
          </div>
        </li>

        <li class="timeline__item" data-reveal="stagger">
          <div class="timeline__content">
            <h3 class="text-gradient">Continental Automotive Technologies GmbH</h3>
            <span class="chip">September 2019 - August 2025</span>

            <ol class="timeline__sub">
              <li class="timeline__sub-item" data-reveal="stagger">
                <p class="timeline__title">Softwareentwickler</p>
                <span class="chip">Februar 2024 - August 2025</span>
              </li>

              <li class="timeline__sub-item" data-reveal="stagger">
                <p class="timeline__title">Studium Plus Mathem.-Tech. Softwareentwickler</p>
                <span class="chip">September 2019 - Februar 2024</span>
              </li>

              <li class="timeline__sub-item" data-reveal="stagger">
                <p class="timeline__title">Bachelor Thesis</p>
                <p class="timeline__meta">
                  Parallele Ausführung kryptographischer Operationen auf Steuergeräten im Automotive-Bereich.
                </p>
                <span class="chip">September 2023 - Dezember 2023</span>
                <div class="chip-row">
                  <span class="chip chip--primary">AUTOSAR</span>
                  <span class="chip chip--primary">AUTOSAR Crypto Stack</span>
                  <span class="chip chip--primary">Cryptography</span>
                  <span class="chip chip--primary">Cipher-Based Message Authentication Code</span>
                </div>
              </li>

              <li class="timeline__sub-item" data-reveal="stagger">
                <p class="timeline__title">Praxissemester</p>
                <p class="timeline__meta">
                  Portieren und Anpassen verschiedener Tests von einer Plattform auf ein Kundenprojekt.
                </p>
                <span class="chip">Oktober 2022 - März 2023</span>
                <div class="chip-row">
                  <span class="chip chip--primary">Elektrobit Tresos Studio</span>
                  <span class="chip chip--primary">AUTOSAR</span>
                  <span class="chip chip--primary">AUTOSAR Builder</span>
                  <span class="chip chip--primary">CAPL</span>
                  <span class="chip chip--primary">CAN</span>
                  <span class="chip chip--primary">CANoe</span>
                </div>
              </li>

              <li class="timeline__sub-item" data-reveal="stagger">
                <p class="timeline__title">Mathematisch-technischer Softwareentwickler (MATSE)</p>
                <p class="timeline__meta">Ausbildung zum Mathematisch-technischen Softwareentwickler (MATSE)</p>
                <p class="timeline__meta">(Enthalten im Studium Plus)</p>
                <span class="chip">September 2019 - August 2021</span>
              </li>
            </ol>
          </div>
        </li>

        <li class="timeline__item" data-reveal="stagger">
          <div class="timeline__content">
            <h3 class="text-gradient">Persönliche Projekte</h3>

            <ol class="timeline__sub">
              <li class="timeline__sub-item" data-reveal="stagger">
                <p class="timeline__title">Softwareentwickler Mobile Apps</p>
                <p class="timeline__meta">Entwicklung moderner Apps in Samsungs OneUI-Design.</p>
                <div class="chip-row">
                  <span class="chip">Dezember 2019 - Heute</span>
                  <span class="chip chip--secondary">Remote</span>
                </div>
                <div class="timeline__actions">
                  <button class="button-pill"><a href={getRelativeLocaleUrl('de', '/apps')}>Projekte</a></button>
                  <button class="button-pill"><a href="mailto:apps@leonard-lemke.com">Kontakt</a></button>
                </div>
              </li>

              <li class="timeline__sub-item" data-reveal="stagger">
                <p class="timeline__title">Digital Creator</p>
                <p class="timeline__meta">Bearbeiten von Videoaufnahmen einer Racing-Drohne.</p>
                <p class="timeline__meta">Teilen von Erlebnissen durch die Augen einer Drohne.</p>
                <div class="chip-row">
                  <span class="chip">Mai 2019 - Heute</span>
                  <span class="chip chip--secondary">Remote</span>
                </div>
                <div class="timeline__actions">
                  <button class="button-pill"><a href={getRelativeLocaleUrl('de', '/media')}>Projekte</a></button>
                  <button class="button-pill"><a href="mailto:media@leonard-lemke.com">Kontakt</a></button>
                </div>
              </li>
            </ol>
          </div>
        </li>
      </ol>
    </div>

    <div id="education" class="section-gap">
      <h2 class="heading-display text-gradient">Bildung</h2>

      <ol class="timeline">
        <li class="timeline__item" data-reveal="stagger">
          <div class="timeline__content">
            <h3 class="text-gradient">Bachelor of Science (B.Sc.)</h3>
            <p class="timeline__meta">Hochschule Furtwangen University (HFU) / Continental</p>
            <p class="timeline__meta">Allgemeine Informatik (Vertiefungsrichtung Software Engineering)</p>
            <p class="timeline__meta">Studium Plus</p>
            <div class="chip-row">
              <span class="chip">September 2019 - Februar 2024</span>
              <span class="chip chip--secondary">Note: 1,4</span>
            </div>
          </div>
        </li>

        <li class="timeline__item" data-reveal="stagger">
          <div class="timeline__content">
            <h3 class="text-gradient">Ausbildung</h3>
            <p class="timeline__meta">
              Kaufmännische und Hauswirtschaftliche Schulen Donaueschingen (KHS) / Continental
            </p>
            <p class="timeline__meta">Mathematisch-technischer Softwareentwickler (MATSE)</p>
            <p class="timeline__meta">(Enthalten im Studium Plus)</p>
            <div class="chip-row">
              <span class="chip">September 2019 - Juli 2021</span>
              <span class="chip chip--secondary">Note: 90/100 P.</span>
            </div>
          </div>
        </li>

        <li class="timeline__item" data-reveal="stagger">
          <div class="timeline__content">
            <h3 class="text-gradient">Abitur</h3>
            <p class="timeline__meta">Gymnasium Trossingen</p>
            <div class="chip-row">
              <span class="chip">September 2011 - Juli 2019</span>
              <span class="chip chip--secondary">Note: 1,7</span>
            </div>
          </div>
        </li>
      </ol>
    </div>
  </div>

  <Giscus />
</BaseLayout>
