---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Giscus from '@/components/Giscus.astro';
import Gallery from '@/components/Gallery.astro';
import Banner from '@/components/Banner.astro';
import bannerImg from '@/assets/images/about/banner.jpg';
import ogImg from '@/assets/images/about/me2.jpg';
import meImg from '@/assets/images/about/me.jpg';
import me3Img from '@/assets/images/about/me3.jpg';
import me4Img from '@/assets/images/about/me4.jpg';
import me5Img from '@/assets/images/about/me5.jpg';
---

<BaseLayout title="Leonard Lemke" description="Über mich" image={ogImg}>
  <Banner
    image={bannerImg}
    title="About"
    subtitle={'"Wer den schnellen Erfolg sucht, sollte nicht programmieren, sondern Holz hacken."'}
    imageAlt="KI-generierte abstrakte Grafik eines nebligen Waldes mit leuchtenden, codeartigen Lichtspuren"
  />

  <div class="content">
    <h2 id="me" class="heading-display text-gradient">Leonard Lemke</h2>
    <p class="quote">
      Hallo, mein Name ist Leonard. Neben meiner Leidenschaft für Technik, Smartphones, Android und Computerspiele,
      programmiere ich gerne Apps für Android im OneUI-Design oder bearbeite Videos, die ich mit meiner Racing-Drohne
      aufnehme.
    </p>
    <Gallery>
      <Image src={meImg} alt="" />
      <Image src={me3Img} alt="" />
      <Image src={me4Img} alt="" />
      <Image src={me5Img} alt="" />
    </Gallery>

    <div id="experience" class="section-gap">
      <h2 class="heading-display text-gradient">Erfahrung</h2>

      <ol class="timeline">
        <li class="timeline__item" data-reveal="stagger" style="--i: 0">
          <div class="timeline__marker" aria-hidden="true"></div>
          <div class="timeline__content">
            <h3 class="text-gradient">AUMOVIO</h3>
            <p class="timeline__date">September 2025 - Heute</p>

            <ol class="timeline__sub">
              <li class="timeline__sub-item" data-reveal="stagger" style="--i: 0">
                <p class="timeline__role">Softwareentwickler / Softwarearchitekt</p>
                <p class="timeline__date">September 2025 - Heute</p>
              </li>
            </ol>
          </div>
        </li>

        <li class="timeline__item" data-reveal="stagger" style="--i: 1">
          <div class="timeline__marker" aria-hidden="true"></div>
          <div class="timeline__content">
            <h3 class="text-gradient">Continental Automotive Technologies GmbH</h3>
            <p class="timeline__date">September 2019 - August 2025</p>

            <ol class="timeline__sub">
              <li class="timeline__sub-item" data-reveal="stagger" style="--i: 0">
                <p class="timeline__role">Softwareentwickler</p>
                <p class="timeline__date">Februar 2024 - August 2025</p>
              </li>

              <li class="timeline__sub-item" data-reveal="stagger" style="--i: 1">
                <p class="timeline__role">Studium Plus Mathem.-Tech. Softwareentwickler</p>
                <p class="timeline__date">September 2019 - Februar 2024</p>
              </li>

              <li class="timeline__sub-item" data-reveal="stagger" style="--i: 2">
                <p class="timeline__role">Bachelor Thesis</p>
                <p class="timeline__date">September 2023 - Dezember 2023</p>
                <p class="timeline__description">
                  Parallele Ausführung kryptographischer Operationen auf Steuergeräten im Automotive-Bereich.
                </p>
                <div class="timeline__skills">
                  <span class="skill-tag">AUTOSAR</span>
                  <span class="skill-tag">AUTOSAR Crypto Stack</span>
                  <span class="skill-tag">Cryptography</span>
                  <span class="skill-tag">Cipher-Based Message Authentication Code</span>
                </div>
              </li>

              <li class="timeline__sub-item" data-reveal="stagger" style="--i: 3">
                <p class="timeline__role">Praxissemester</p>
                <p class="timeline__date">Oktober 2022 - März 2023</p>
                <p class="timeline__description">
                  Portieren und Anpassen verschiedener Tests von einer Plattform auf ein Kundenprojekt.
                </p>
                <div class="timeline__skills">
                  <span class="skill-tag">Elektrobit Tresos Studio</span>
                  <span class="skill-tag">AUTOSAR</span>
                  <span class="skill-tag">AUTOSAR Builder</span>
                  <span class="skill-tag">CAPL</span>
                  <span class="skill-tag">CAN</span>
                  <span class="skill-tag">CANoe</span>
                </div>
              </li>

              <li class="timeline__sub-item" data-reveal="stagger" style="--i: 4">
                <p class="timeline__role">Mathematisch-technischer Softwareentwickler (MATSE)</p>
                <p class="timeline__date">September 2019 - August 2021</p>
                <p class="timeline__description">Ausbildung zum Mathematisch-technischen Softwareentwickler (MATSE)</p>
                <p class="timeline__description">(Enthalten im Studium Plus)</p>
              </li>
            </ol>
          </div>
        </li>

        <li class="timeline__item" data-reveal="stagger" style="--i: 2">
          <div class="timeline__marker" aria-hidden="true"></div>
          <div class="timeline__content">
            <h3 class="text-gradient">Softwareentwickler Mobile Apps</h3>
            <p class="timeline__date">Dezember 2019 - Heute</p>
            <p class="timeline__location">Remote - Leonard Lemke</p>
            <p class="timeline__description">Entwicklung moderner Apps in Samsungs OneUI-Design.</p>
            <div class="timeline__actions">
              <button class="button-pill"><a href={getRelativeLocaleUrl('de', '/apps')}>Projekte</a></button>
              <button class="button-pill"><a href="mailto:apps@leonard-lemke.com">Kontakt</a></button>
            </div>
          </div>
        </li>

        <li class="timeline__item" data-reveal="stagger" style="--i: 3">
          <div class="timeline__marker" aria-hidden="true"></div>
          <div class="timeline__content">
            <h3 class="text-gradient">Digital Creator</h3>
            <p class="timeline__date">Mai 2019 - Heute</p>
            <p class="timeline__location">Remote - Leonard Lemke</p>
            <p class="timeline__description">Bearbeiten von Videoaufnahmen einer Racing-Drohne.</p>
            <p class="timeline__description">Teilen von Erlebnissen durch die Augen einer Drohne.</p>
            <div class="timeline__actions">
              <button class="button-pill"><a href={getRelativeLocaleUrl('de', '/media')}>Projekte</a></button>
              <button class="button-pill"><a href="mailto:media@leonard-lemke.com">Kontakt</a></button>
            </div>
          </div>
        </li>
      </ol>
    </div>

    <div id="education" class="section-gap">
      <h2 class="heading-display text-gradient">Bildung</h2>

      <ol class="timeline">
        <li class="timeline__item" data-reveal="stagger" style="--i: 0">
          <div class="timeline__marker" aria-hidden="true"></div>
          <div class="timeline__content">
            <h3>Bachelor of Science (B.Sc.)</h3>
            <p class="timeline__date">September 2019 - Februar 2024</p>
            <span class="timeline__grade">Note: 1,4</span>
            <p class="timeline__location">Hochschule Furtwangen University (HFU) / Continental</p>
            <p class="timeline__description">Allgemeine Informatik (Vertiefungsrichtung Software Engineering)</p>
            <p class="timeline__description">Studium Plus</p>
          </div>
        </li>

        <li class="timeline__item" data-reveal="stagger" style="--i: 1">
          <div class="timeline__marker" aria-hidden="true"></div>
          <div class="timeline__content">
            <h3>Ausbildung</h3>
            <p class="timeline__date">September 2019 - Juli 2021</p>
            <span class="timeline__grade">Note: 90/100 P.</span>
            <p class="timeline__location">
              Kaufmännische und Hauswirtschaftliche Schulen Donaueschingen (KHS) / Continental
            </p>
            <p class="timeline__description">Mathematisch-technischer Softwareentwickler (MATSE)</p>
            <p class="timeline__description">(Enthalten im Studium Plus)</p>
          </div>
        </li>

        <li class="timeline__item" data-reveal="stagger" style="--i: 2">
          <div class="timeline__marker" aria-hidden="true"></div>
          <div class="timeline__content">
            <h3>Abitur</h3>
            <p class="timeline__date">September 2011 - Juli 2019</p>
            <span class="timeline__grade">Note: 1,7</span>
            <p class="timeline__location">Gymnasium Trossingen</p>
          </div>
        </li>
      </ol>
    </div>
  </div>

  <Giscus />
</BaseLayout>
