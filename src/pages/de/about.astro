---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Giscus from '@/components/Giscus.astro';
import Gallery from '@/components/Gallery.astro';
import Banner from '@/components/Banner.astro';
import bannerImg from '@/assets/images/about/banner.jpg';
import ogImg from '@/assets/images/about/me2.jpg';
import meImg from '@/assets/images/about/me.jpg';
import me3Img from '@/assets/images/about/me3.jpg';
import me4Img from '@/assets/images/about/me4.jpg';
import me5Img from '@/assets/images/about/me5.jpg';
---

<BaseLayout title="Leonard Lemke" description="Über mich" image={ogImg}>
  <Banner
    image={bannerImg}
    title="About"
    subtitle={'"Wer den schnellen Erfolg sucht, sollte nicht programmieren, sondern Holz hacken."'}
    imageAlt="KI-generierte abstrakte Grafik eines nebligen Waldes mit leuchtenden, codeartigen Lichtspuren"
    scrambleTitle
  />

  <div class="content">
    <h1 id="me" data-reveal="up">Leonard Lemke</h1>
    <p class="quote" data-reveal="up">
      Hallo, mein Name ist Leonard. Neben meiner Leidenschaft für Technik, Smartphones, Android und
      Computerspiele, programmiere ich gerne Apps für Android im OneUI-Design oder bearbeite Videos, die ich mit
      meiner Racing-Drohne aufnehme.
    </p>
    <Gallery class="me-swiper">
      <Image src={meImg} alt="" />
      <Image src={me3Img} alt="" />
      <Image src={me4Img} alt="" />
      <Image src={me5Img} alt="" />
    </Gallery>

    <div id="experience" data-reveal="up">
      <br /><br /><br /><br />
      <h1>Erfahrung</h1>

      <h2>AUMOVIO</h2>
      <p class="about-date">September 2025 - Heute</p>

      <h3>Softwareentwickler / Softwarearchitekt</h3>
      <p class="about-date">September 2025 - Heute</p>

      <br /><br /><br />
      <h2>Continental Automotive Technologies GmbH</h2>
      <p class="about-date">September 2019 - August 2025</p>

      <h3>Softwareentwickler</h3>
      <p class="about-date">Februar 2024 - August 2025</p>

      <h3>Studium Plus Mathem.-Tech. Softwareentwickler</h3>
      <p class="about-date">September 2019 - Februar 2024</p>

      <h3>Bachelor Thesis</h3>
      <p class="about-date">September 2023 - Dezember 2023</p>
      <p class="about-description">
        Parallele Ausführung kryptographischer Operationen auf Steuergeräten im Automotive-Bereich.
      </p>
      <p class="about-skills">
        Skills: AUTOSAR, AUTOSAR Crypto Stack, Cryptography, Cipher-Based Message Authentication Code
      </p>

      <h3>Praxissemester</h3>
      <p class="about-date">Oktober 2022 - März 2023</p>
      <p class="about-description">Portieren und Anpassen verschiedener Tests von einer Plattform auf ein Kundenprojekt.</p>
      <p class="about-skills">Skills: Elektrobit Tresos Studio, AUTOSAR, AUTOSAR Builder, CAPL, CAN, CANoe</p>

      <h3>Mathematisch-technischer Softwareentwickler (MATSE)</h3>
      <p class="about-date">September 2019 - August 2021</p>
      <p class="about-description">Ausbildung zum Mathematisch-technischen Softwareentwickler (MATSE)</p>
      <p class="about-description">(Enthalten im Studium Plus)</p>

      <br /><br /><br />
      <h2>Softwareentwickler Mobile Apps</h2>
      <p class="about-location">Remote - Leonard Lemke</p>
      <p class="about-date">Dezember 2019 - Heute</p>
      <p class="about-description">Entwicklung moderner Apps in Samsungs OneUI-Design.</p>
      <button class="lButton"><a href={getRelativeLocaleUrl('de', '/apps')}>Projekte</a></button>
      <button class="lButton"><a href="mailto:apps@leonard-lemke.com">Kontakt</a></button>

      <br /><br /><br />
      <h2>Digital Creator</h2>
      <p class="about-location">Remote - Leonard Lemke</p>
      <p class="about-date">Mai 2019 - Heute</p>
      <p class="about-description">Bearbeiten von Videoaufnahmen einer Racing-Drohne.</p>
      <p class="about-description">Teilen von Erlebnissen durch die Augen einer Drohne.</p>
      <button class="lButton"><a href={getRelativeLocaleUrl('de', '/media')}>Projekte</a></button>
      <button class="lButton"><a href="mailto:media@leonard-lemke.com">Kontakt</a></button>
    </div>

    <div id="education" data-reveal="up">
      <br /><br /><br /><br />
      <h1>Bildung</h1>
      <h2>Bachelor of Science (B.Sc.)</h2>
      <p class="about-location">Hochschule Furtwangen University (HFU) / Continental</p>
      <p class="about-date">September 2019 - Februar 2024</p>
      <p class="about-description">Allgemeine Informatik (Vertiefungsrichtung Software Engineering)</p>
      <p class="about-description">Studium Plus</p>
      <p class="about-grade">Note: 1,4</p>

      <h2>Ausbildung</h2>
      <p class="about-location">Kaufmännische und Hauswirtschaftliche Schulen Donaueschingen (KHS) / Continental</p>
      <p class="about-date">September 2019 - Juli 2021</p>
      <p class="about-description">Mathematisch-technischer Softwareentwickler (MATSE)</p>
      <p class="about-description">(Enthalten im Studium Plus)</p>
      <p class="about-grade">Note: 90/100 P.</p>

      <h2>Abitur</h2>
      <p class="about-location">Gymnasium Trossingen</p>
      <p class="about-date">September 2011 - Juli 2019</p>
      <p class="about-grade">Note: 1,7</p>
    </div>
  </div>

  <Giscus />
</BaseLayout>
