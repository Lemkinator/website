---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Giscus from '@/components/Giscus.astro';
import CardGrid from '@/components/CardGrid.astro';
import Card from '@/components/Card.astro';
import Banner from '@/components/Banner.astro';

const apps = (await getCollection('apps', (entry) => entry.id.startsWith('de/'))).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout title="Apps" description="Leonard Lemke" image="/images/apps/oneUI/OneUIBanner.jpg">
  <Banner image="/images/apps/oneUI/OneUIBanner.jpg" title="Apps" subtitle="Moderne Apps in Samsungs OneUI-Design." />

  <CardGrid>
    {
      apps.map((app) => (
        <Card
          href={`/de/apps/${app.data.slug}`}
          bgImg={app.data.icon}
          title={app.data.name}
          description={app.data.tagline}
          date={app.data.date.toLocaleDateString('de-DE', { month: 'short', year: 'numeric' })}
          interactionIcon="download"
          interactionText={app.data.downloads}
          tags={app.data.tags}
          iconStyle
        />
      ))
    }
  </CardGrid>

  <Giscus />
</BaseLayout>
