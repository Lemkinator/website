---
import { getCollection, render } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { Image } from 'astro:assets';
import ProjectLayout from '@/layouts/ProjectLayout.astro';
import Banner from '@/components/Banner.astro';
import playStoreBadge from '@/assets/images/apps/google-play-badge-de.png';

export async function getStaticPaths() {
  const entries = await getCollection('apps', (entry) => entry.id.startsWith('de/'));
  return entries.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { name, tagline, icon, bannerImage, bannerImageAlt, playStoreUrl, githubUrl, privacyPolicy } = entry.data;
---

<ProjectLayout title={name} description={tagline} image={bannerImage}>
  <Banner
    image={bannerImage}
    title={name}
    subtitle={tagline}
    imageAlt={bannerImageAlt}
    transitionName={`proj-app-${entry.data.slug}`}
  >
    {
      playStoreUrl && (
        <a target="_blank" rel="noopener noreferrer" href={playStoreUrl}>
          <Image class="playstore-button" alt="Jetzt bei Google Play" src={playStoreBadge} format="png" />
        </a>
      )
    }
  </Banner>

  <div class="content" data-reveal="up">
    {/* Rendered at 80x80 CSS px (site.css #app-icon) — 160 covers 2x DPR. */}
    <Image id="app-icon" src={icon} alt="" width={160} height={160} />
    <h2>{name}</h2>
    <Content />

    <div id="links" class="section-gap">
      <h2>Links</h2>
      {
        privacyPolicy && (
          <button class="button-pill">
            <a href={getRelativeLocaleUrl('de', `/apps/${entry.data.slug}/privacy-policy`)}>Datenschutzerklärung</a>
          </button>
        )
      }
      {
        githubUrl && (
          <button class="button-pill">
            <a target="_blank" rel="noopener noreferrer" aria-label="GitHub" href={githubUrl}>
              Source Code
            </a>
          </button>
        )
      }
    </div>
  </div>
</ProjectLayout>
