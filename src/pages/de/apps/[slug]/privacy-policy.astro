---
import { getCollection } from 'astro:content';
import PrivacyPolicyLayout from '@/layouts/PrivacyPolicyLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection(
    'apps',
    (entry) => entry.id.startsWith('de/') && entry.data.privacyPolicy,
  );
  return entries.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { name, icon } = entry.data;
const { contactEmail, lastUpdated, includesPlayGamesSection } = entry.data.privacyPolicy!;
---

<PrivacyPolicyLayout appName={name} lastUpdated={lastUpdated} icon={icon}>
  <h1>Datenschutzerklärung</h1>

  <h2>App</h2>
  <p>{name}</p>

  <h2>Anbieter/Betreiber</h2>
  <p>Leonard Lemke</p>
  <p>Email: <a href={`mailto:${contactEmail}`}>{contactEmail}</a></p>

  <h2>Informationen zum Datenschutz</h2>
  {
    includesPlayGamesSection ? (
      <>
        <p>
          Die unten genannten Daten werden von{' '}
          <a href="https://support.google.com/googleplay/topic/3114802?ref_topic=2952998">Google Play Spiele</a>{' '}
          erhoben, sofern der Nutzer sich anmeldet oder die automatische Anmeldung aktiviert hat. Die Google
          Play-Dienste für Spiele stellen Zugriff für die Anmeldung sowie Dienste für Spiele-Apps bereit. Weitere
          Einstellungen, sowie die Löschung der Daten können im Play Spiele-Profil vorgenommen werden.
        </p>
        <p>
          <a href="https://support.google.com/googleplay/answer/3129346?ref_topic=9167070">
            Datenschutz und andere Einstellungen für das Play Spiele-Profil
          </a>
        </p>
        <p>
          <a href="https://support.google.com/googleplay/answer/9130646">
            Play Spiele-Profil und zugehörige Daten löschen
          </a>
        </p>

        <h3>Datenverschlüsselung</h3>
        <p>
          Für die gesammelten Endnutzerdaten, die auf dieser Seite aufgeführt sind, verschlüsselt Play Games
          Services die Daten während der Übertragung mit HTTPS.
        </p>

        <h3>Erfasste Daten</h3>
        <p>Identität des Spielers (Gamertag, Avatar), Analyse- und Diagnose-Daten und App Aktivitäten (z.B. Erfolge, Spielstände).</p>

        <h3>Löschung von Daten</h3>
        <p>
          Nutzer können ihr Konto und alle damit verbundenen Spieldaten, die von Google gesammelt wurden, über ihr{' '}
          <a href="https://play.google.com/games/profile">Play Spiele-Profil</a> oder{' '}
          <a href="https://myaccount.google.com/">Google Konto</a> löschen.
        </p>
        <p>
          Wenn Google Play Games Services-Daten für ein einzelnes Spiel sammelt, können die Nutzer die Daten über
          ihr <a href="https://play.google.com/games/profile">Play Spiele-Profil</a> löschen.
        </p>
      </>
    ) : (
      <p>Die App erhebt oder teilt keine Nutzerdaten.</p>
    )
  }

  <h2>Stand der Datenschutzinformationen</h2>
  <p>
    Wir überprüfen unsere Datenschutzhinweise regelmäßig. Wir behalten uns das Recht vor, die
    Datenschutzerklärung jederzeit mit oder ohne vorherige Ankündigung zu ändern. Bitte schauen Sie
    regelmäßig vorbei, um über Änderungen informiert zu werden.
  </p>
</PrivacyPolicyLayout>
