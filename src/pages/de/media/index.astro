---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Giscus from '@/components/Giscus.astro';
import CardGrid from '@/components/CardGrid.astro';
import Card from '@/components/Card.astro';
import Gallery from '@/components/Gallery.astro';
import Banner from '@/components/Banner.astro';
import { useTranslations } from '@/i18n/ui';
import { getMediaCards } from '@/lib/projects';
import mediaBannerImage from '@/assets/images/media/banner.jpg';

const t = useTranslations('de');

const projects = await getMediaCards('de');
---

<BaseLayout title="Media" description="Leonard Lemke" image="/images/media/evoque_v2.jpg">
  <Banner
    image={mediaBannerImage}
    title="Media"
    subtitle={t('home.mediaTagline')}
    imageAlt="KI-generierte abstrakte Grafik von FPV-Drohnen-Lichtspuren am Nachthimmel"
    transitionName="hub-media"
    scrambleTitle
  />

  <div class="center" id="projects" data-reveal="up">
    <h1 class="colored-h1">Projekte</h1>
  </div>

  <CardGrid>
    {
      projects.map((project, i) => (
        <Card
          href={project.href}
          bgImg={project.bgImg}
          title={project.title}
          description={project.description}
          date={project.dateLabel}
          interactionIcon={project.interactionIcon}
          interactionText={project.interactionText}
          tags={project.tags}
          transitionName={project.transitionName}
          revealIndex={i}
          previewVideo={project.previewVideo}
        />
      ))
    }
  </CardGrid>

  <div class="content" id="fpv" data-reveal="up">
    <h1>Was ist Cinematic/Freestyle FPV?</h1>
    <ul>
      <li>
        <b>First-Person-View (FPV)</b> ist eine Methode, bei der ein funkgesteuertes Fluggerät (Drohne) aus der
        Ich-Perspektive über eine Bordkamera ferngesteuert wird, die drahtlos an eine FPV-Videobrille übertragen
        wird.
      </li>
      <li>Bei <b>Freestyle FPV</b> geht es um Flugkünste und schöne Tricks oder Bewegungen.</li>
      <li>
        <b>Cinematic FPV</b> ist tendenziell langsamer und flüssiger als Freestyle FPV. Die Einstellungen werden
        eher wegen ihres visuellen Reizes gewählt als wegen der technischen Flugfähigkeiten, die sie erfordern.
      </li>
    </ul>

    <h2>Was ist das Besondere an FPV?</h2>
    <p>Der Unterschied zu normalen Drohnenpiloten ist, dass FPV-Piloten ihre Drohne(n) meist selbst bauen.</p>
    <h3>Dies beinhaltet:</h3>
    <ul>
      <li>Teile suchen und kaufen</li>
      <li>Zusammenbau der Drohne</li>
      <li>Einrichten der Drohne (Software)</li>
    </ul>
    <p>
      Außerdem erfordert es viel mehr Übung, da FPV-Drohnen in der Regel im Akro-Modus geflogen werden
      (Akrobatik-Modus: z.B. wenn man die Steuerknüppel loslässt, bewegt sich die Drohne nicht automatisch wieder
      in ihre Ausgangsposition, oder wenn man die Knüppel nach vorne bewegt, neigt sich die Drohne kontinuierlich
      nach vorne, anstatt nach vorne zu beschleunigen...).
    </p>
    <p>Aber die Übung ist es wert, denn FPV-Fliegen macht unglaublich viel Spaß!</p>

    <h2>Was hat mich zu FPV gebracht?</h2>
    <Gallery full>
      <div>
        <img src="/images/media/drone1.jpg" alt="" />
        <p class="description">Die Reise begann mit einer normalen Verbraucherdrohne...</p>
      </div>
      <div>
        <img src="/images/media/drone2.jpg" alt="" />
        <p class="description">
          ... endete aber sehr früh mit einer kaputten Drohne und der Tatsache, dass es fast unmöglich ist, diese
          Drohnen selbst zu reparieren.
        </p>
      </div>
      <div>
        <img src="/images/media/drone3.jpg" alt="" />
        <p class="description">
          Da die Reparatur beim Hersteller teuer ist, habe ich mich entschlossen, selbst eine Drohne zu bauen...
          Was sich als nicht billiger erwies...
        </p>
      </div>
      <div>
        <img src="/images/media/drone4.jpg" alt="" />
        <p class="description">Nach der Suche nach den benötigten Teilen begann der Zusammenbau.</p>
      </div>
      <div>
        <img src="/images/media/drone5.jpg" alt="" />
        <p class="description">Zusammenbau und Verkabelung...</p>
      </div>
      <div>
        <img src="/images/media/drone6.jpg" alt="" />
        <p class="description">Vorbereitungen für die Hardware...</p>
      </div>
      <div>
        <img src="/images/media/drone7.jpg" alt="" />
        <p class="description">Einrichtung und Konfiguration der Software...</p>
      </div>
      <div>
        <img src="/images/media/drone8.jpg" alt="" />
        <p class="description">Fertig!</p>
      </div>
      <div>
        <img src="/images/media/drone9.jpg" alt="" />
        <p class="description">
          Nun (nach ein paar Begegnungen mit dem schneebedeckten Boden)... scheint robuster als die alte Drohne...
        </p>
      </div>
    </Gallery>
  </div>

  <div class="content" data-reveal="up">
    <h1 id="setup">Setup</h1>
    <h2 id="2023">2023</h2>
    <h3>iFlight Nazgul Evoque F5 V2 HD</h3>
    <ul>
      <li>Frame: Nazgul F5 DeadCat</li>
      <li>Motor: XING2 2207 1855KV</li>
      <li>Props: Nazgul F5</li>
      <li>FC: BLITZ Mini F722</li>
      <li>ESC: BLITZ Mini E55 4-IN-1 2-6S 55A</li>
      <li>Video Transmission: DJI O3 Air Unit</li>
      <li>Receiver: TBS Crossfire Nano</li>
      <li>LiPo: Tattu R-LINE V4.0 1300mAh 130C 6S</li>
    </ul>
    <img class="drone-image" src="/images/media/evoque_v2.jpg" alt="iFlight Nazgul Evoque F5 V2 HD" />

    <br id="2021" /><br /><br />
    <h2>2021 - 2023</h2>
    <h3>Drone (Custom Build, 5 Inch)</h3>
    <ul>
      <li>Frame: iFlight Cidora SL5</li>
      <li>Motor: iFlight XING-E 2306 1700KV</li>
      <li>Props: HQProp DP5X4.3X3V1S</li>
      <li>Stack: Mamba F722S 60A</li>
      <li>Video Transmission: Caddx Vista Kit / Air Unit Lite</li>
      <li>Receiver: TBS Crossfire Nano</li>
      <li>LiPo: Tattu R-LINE V3.0 1300mAh 120C 6S</li>
      <li>GoPro Hero 6 Black</li>
    </ul>
    <img class="drone-image" src="/images/media/drone8.jpg" alt="Drone (Custom Build, 5 Inch)" />
    <h3>Cinewhoop (iFlight ProTek25)</h3>
    <ul>
      <li>Motor: iFlight XING 1404 4600KV</li>
      <li>Props: Nazgul 2525</li>
      <li>Stack: SucceX-D 20A Whoop AIO</li>
      <li>Video Transmission: Caddx Vista Kit / Air Unit Lite</li>
      <li>Receiver: TBS Crossfire Nano</li>
      <li>LiPo: Tattu R-LINE V1.0 850mAh 95C 4S</li>
      <li>Naked GoPro Hero 6 Black</li>
    </ul>
    <img class="drone-image" src="/images/media/protek_25.jpg" alt="Cinewhoop (iFlight ProTek25)" />
    <h3>Other</h3>
    <ul>
      <li>Radio: FrSky Taranis X-Lite S</li>
      <li>Goggles: DJI FPV Goggles V2</li>
      <li>Charger: HOTA D6 PRO DUAL Smart Charger AC/DC</li>
    </ul>

    <br id="2020" /><br /><br />
    <h2>2020 - 2021</h2>
    <h3>Drone (Custom Build, 5 Inch)</h3>
    <ul>
      <li>Frame: iFlight Cidora SL5</li>
      <li>Motor: iFlight XING-E 2306 1700KV</li>
      <li>Props: HQProp DP5X4.3X3V1S</li>
      <li>Stack: Mamba F722S 60A</li>
      <li>Cam: Foxeer Falkor 2 Mini</li>
      <li>VTX: Rush Tank Ultimate</li>
      <li>Receiver: TBS Crossfire Nano</li>
      <li>LiPo: Goldbat 1300mAh 100C 6S</li>
      <li>GoPro Hero 6 Black</li>
    </ul>
    <h3>Other</h3>
    <ul>
      <li>Radio: FrSky Taranis X-Lite S</li>
      <li>Goggles: Eachine EV800D</li>
      <li>Charger: ISDT 600AC</li>
    </ul>
  </div>

  <Giscus />
</BaseLayout>
