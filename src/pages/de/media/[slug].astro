---
import { getCollection, render } from 'astro:content';
import ProjectLayout from '@/layouts/ProjectLayout.astro';
import Banner from '@/components/Banner.astro';
import { useTranslations } from '@/i18n/ui';
import { MEDIA_BANNER_FOCAL_POSITION } from '@/lib/projects';

const t = useTranslations('de');

export async function getStaticPaths() {
  const entries = await getCollection('media', (entry) => entry.id.startsWith('de/'));
  return entries.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, description, bannerImage, bannerImageAlt } = entry.data;
---

<ProjectLayout title={title} description={description} image={bannerImage}>
  <Banner
    image={bannerImage}
    title={title}
    subtitle={t('home.mediaTagline')}
    imageAlt={bannerImageAlt}
    focalPosition={MEDIA_BANNER_FOCAL_POSITION[entry.data.slug]}
    transitionName={`proj-media-${entry.data.slug}`}
  />

  <div class="content" data-reveal="up">
    <Content />
  </div>
</ProjectLayout>
