---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Giscus from '@/components/Giscus.astro';
import CardGrid from '@/components/CardGrid.astro';
import Card from '@/components/Card.astro';
import Banner from '@/components/Banner.astro';
import { useTranslations, defaultLocale, type Locale } from '@/i18n/ui';

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);

const apps = await getCollection('apps', (entry) => entry.id.startsWith('de/'));
const media = await getCollection('media', (entry) => entry.id.startsWith('de/'));

const allProjects = [
  ...apps.map((app) => ({
    href: `/de/apps/${app.data.slug}`,
    bgImg: app.data.icon,
    title: app.data.name,
    description: app.data.tagline,
    date: app.data.date,
    dateLabel: app.data.date.toLocaleDateString('de-DE', { month: 'short', year: 'numeric' }),
    interactionIcon: 'download' as const,
    interactionText: app.data.downloads,
    tags: app.data.tags,
    iconStyle: true,
  })),
  ...media.map((project) => ({
    href: `/de/media/${project.data.slug}`,
    bgImg: project.data.coverImage,
    title: project.data.title,
    description: project.data.description,
    date: project.data.date,
    dateLabel: project.data.date.toLocaleDateString('de-DE', { day: '2-digit', month: 'short', year: 'numeric' }),
    interactionIcon: 'eye' as const,
    interactionText: project.data.views,
    tags: project.data.tags,
    iconStyle: false,
  })),
].sort((a, b) => b.date.valueOf() - a.date.valueOf());
---

<BaseLayout title="Leonard Lemke" description="Website">
  <Banner image="/images/about/me2.jpg" title="Leonard Lemke" subtitle="Softwareentwickler mit Leidenschaft für Apps im OneUI-Design & FPV-Drohnen" />

  <div class="center">
    <h1 class="colored-h1">Projekte</h1>
  </div>

  <CardGrid>
    <Card
      href="/de/apps"
      bgImg="https://www.leonard-lemke.com/images/apps/oneUI/OneUIBanner.jpg"
      title="Apps"
      description="Moderne Apps in Samsungs OneUI-Design."
    />
    <Card
      href="/de/media"
      bgImg="https://www.leonard-lemke.com/images/media/evoque_v2.jpg"
      title="Media"
      description={t('home.mediaTagline')}
    />
  </CardGrid>

  <br id="allprojects" /><br /><br /><br /><br /><br />
  <div class="center">
    <h1 class="colored-h1">Alle Projekte</h1>
  </div>

  <CardGrid>
    {
      allProjects.map((project) => (
        <Card
          href={project.href}
          bgImg={project.bgImg}
          title={project.title}
          description={project.description}
          date={project.dateLabel}
          interactionIcon={project.interactionIcon}
          interactionText={project.interactionText}
          tags={project.tags}
          iconStyle={project.iconStyle}
        />
      ))
    }
  </CardGrid>

  <Giscus />
</BaseLayout>
