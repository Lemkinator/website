---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Banner from '@/components/Banner.astro';
import bannerImg from '@/assets/images/404/banner.jpg';
import errorPosterImg from '@/assets/images/error/error-poster.jpg';
import errorImg from '@/assets/images/error/error.webp';
---

<BaseLayout title="Leonard Lemke" description="404" image={errorPosterImg} noindex>
  <Banner
    image={bannerImg}
    title="404"
    subtitle="Völlig verloren, die Seite die du suchst, ist nicht verfügbar!"
    imageAlt="KI-generierte abstrakte Grafik eines Wegweisers, der sich in verstreute Lichtpartikel auflöst"
    compact
  />
  <div class="error">
    <Image src={errorImg} alt="" width={480} height={360} />
    <button class="lButton"><a href="/de">Home</a></button>
  </div>
</BaseLayout>
